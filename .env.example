# Variáveis de ambiente do frontend (Vite). Copie este arquivo para `.env`.
# Apenas variáveis com prefixo VITE_ são expostas ao cliente no build.

# URL do servidor Socket.IO (backend).
# - Dev:  http://localhost:3001 (valor padrão usado se a var não for definida)
# - Prod: definir no painel do Netlify (Site settings → Environment variables),
#         ex.: https://<backend>.onrender.com — ver DEPLOYMENT_PLAN.md
VITE_WS_URL=http://localhost:3001
