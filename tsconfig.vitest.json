{
  "extends": "./tsconfig.app.json",
  // O tsconfig.app.json EXCLUI `src/**/__tests__/*`; zerar o exclude aqui é o que
  // traz os specs para dentro deste projeto. Os specs de deriva de contrato
  // (src/types/__tests__) ainda importam `server/src`, que precisa estar listado ou
  // o TS o reporta como arquivo fora do projeto — ver o contrato de acoplamento
  // documentado no topo do deck-drift.spec.ts.
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "server/src/types.ts",
    "server/src/validation.ts",
    "server/src/errorCodes.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    // ESSENCIAL, e a razão de os specs terem passado meses sem type-check: sem esta
    // linha o projeto herda o tsBuildInfoFile do tsconfig.app.json, e os dois gravam
    // no MESMO arquivo. O `vue-tsc --build` então lê o carimbo do app ao checar este
    // projeto, conclui que está atualizado e o PULA — em silêncio, com exit 0. Só
    // `--build --force` revelava os erros. Não remova nem aponte para o do app.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["node"]
  }
}
