{
  "$schema": "https://unpkg.com/knip@6.29.0/schema.json",
  "workspaces": {
    // App Vite/Vue: os plugins (vite/vitest/vue) já detectam entries e arquivos.
    ".": {},
    // server/ é um package aninhado com package.json próprio, instalado via
    // `npm --prefix server` (não é workspace npm formal). Declará-lo aqui faz o
    // knip ler as deps de server/package.json (socket.io, @upstash/redis, ...) e
    // tratar src/index.ts como entry — senão tudo do server vira falso-positivo.
    "server": {
      "entry": ["src/index.ts", "test/**/*.spec.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
