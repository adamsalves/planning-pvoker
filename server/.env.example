# Planning Poker — backend (server) environment variables.
# Copy to `server/.env` for local dev, or set these in the Render dashboard for prod.
# Every variable is OPTIONAL: with none set, the server runs exactly as before
# (in-memory only, permissive local CORS, 30s reconnect grace).

# HTTP port the server listens on. Render injects its own PORT; defaults to 3001.
PORT=3001

# Set to "production" to silence per-connection debug logs (player names/ids).
NODE_ENV=development

# Allowed browser origins for CORS/Socket.IO, in addition to the built-in
# localhost + Netlify/Render defaults. Accepts a comma-separated list. Any of
# CLIENT_ORIGIN / CLIENT_ORIGINS / CORS_ORIGIN / RENDER_EXTERNAL_URL is honored.
# CLIENT_ORIGIN=https://planningpvoker.netlify.app

# How long (ms) a disconnected player is kept before removal, so a refresh or a
# brief network blip doesn't drop them (and possibly destroy the room). Default 30000.
# RECONNECT_GRACE_MS=30000

# --- Persistence (Upstash Redis) -------------------------------------------------
# WITHOUT these two, the server keeps all room/session state in memory only, so a
# redeploy or free-tier cold-start loses every active room. WITH them, each mutation
# is mirrored to Redis (write-through) and the server rehydrates rooms + session
# tokens on boot — the room survives the restart. (It does NOT remove the cold start
# itself, only the loss of state.) Create a free database at https://upstash.com and
# copy its REST URL + token here. Read-only from the app's perspective on boot.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# TTL (seconds) for persisted rooms/tokens, refreshed on every write so active
# rooms never expire mid-session. Backstops rooms orphaned by a crash-while-idle.
# Default 86400 (24h).
# ROOM_TTL_SECONDS=86400
